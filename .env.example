# Local persistent Chroma store
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_NAME=code_civil

# Embedding model. Defaults to the -large-instruct variant, which needs a
# GPU to be fast (falls back to CPU, just slowly). No GPU? Set this to
# intfloat/multilingual-e5-small instead — see README's "Embedding model"
# section for the tradeoff.
EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct

# OpenAI-compatible chat model used for answer generation.
# OPENAI_BASE_URL may point at OpenAI itself or any compatible endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Low by default: grounded legal answers, not creative text.
OPENAI_TEMPERATURE=0.0
# Per-request timeout (seconds), for both this client and the judge client
# below -- bounds how long a single unresponsive provider can hang.
OPENAI_TIMEOUT=60.0

# OAuth: /query and /articles/{ref} require an Access Token issued by Keycloak.
# OAUTH_ISSUER is what the token's `iss` must equal; OAUTH_JWKS_URL is where the
# API fetches Keycloak's signing keys (a different host from inside Docker);
# OAUTH_AUDIENCE is what the token's `aud` must contain.
OAUTH_ISSUER=http://localhost:8080/realms/code-civil
OAUTH_JWKS_URL=http://localhost:8080/realms/code-civil/protocol/openid-connect/certs
OAUTH_AUDIENCE=http://localhost:8000/mcp

# Keycloak's admin console (http://localhost:8080/admin), for `docker compose
# up`: read by compose.yaml, which refuses to start without the password.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=

# Number of Articles /query returns when the caller doesn't pass top_k.
DEFAULT_TOP_K=5

# scripts/evaluate.py's RAGAS judge model — kept independent of OPENAI_MODEL so
# changing the model under test doesn't change how strictly it's judged. Uses
# OPENAI_API_KEY above. Defaults to OpenAI itself if EVAL_JUDGE_BASE_URL is unset.
EVAL_JUDGE_BASE_URL=
EVAL_JUDGE_MODEL=gpt-4o-mini

# Access Token scripts/evaluate.py sends with --base-url (a live server).
# Unused in-process. Required in live mode: the run stops at once without it.
EVAL_ACCESS_TOKEN=
