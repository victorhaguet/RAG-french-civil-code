# Local persistent Chroma store
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_NAME=code_civil

# OpenAI-compatible chat model used for answer generation.
# OPENAI_BASE_URL may point at OpenAI itself or any compatible endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Number of Articles /query returns when the caller doesn't pass top_k.
DEFAULT_TOP_K=5
